# Copy to .env and adjust. Env vars always win over this file.
APP_NAME=vehicle-rental-core
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO

# Must use an async driver — psycopg 3.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/vehicle_rental
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

API_HOST=0.0.0.0
API_PORT=8000
METRICS_ENABLED=true
