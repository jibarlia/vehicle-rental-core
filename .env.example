# Copy to .env and adjust. Env vars always win over this file.
APP_NAME=vehicle-rental-core
ENVIRONMENT=local
DEBUG=true
LOG_LEVEL=INFO

# Unset means stdout only. Set a path to also write a rotating file.
# LOG_FILE=logs/vehicle-rental-core.log
# LOG_FILE_MAX_BYTES=10485760
# LOG_FILE_BACKUP_COUNT=5

# Must use an async driver — psycopg 3.
# Port 55432 is what docker-compose publishes to the host.
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:55432/vehicle_rental
DB_ECHO=false
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10

API_HOST=0.0.0.0
API_PORT=8000
METRICS_ENABLED=true
