# Deliberately tracked, do not add here:
#   uv.lock          — pinned dependencies, the point of reproducible installs
#   .python-version  — pins the interpreter for uv
#   .env.example     — the template; only the real .env is ignored
#   .vscode/         — shared launch and editor configuration

# Python bytecode
__pycache__/
*.py[cod]

# Packaging / build artifacts
build/
dist/
*.egg-info/

# Virtual environment (uv creates .venv)
.venv/

# Tooling caches
.pytest_cache/
.ruff_cache/
.mypy_cache/

# Coverage output
.coverage
.coverage.*
coverage.xml
htmlcov/

# Local secrets and overrides
.env
.env.local

# LOG_FILE output
logs/
*.log

# Editors
.idea/
*.swp

# macOS
.DS_Store
